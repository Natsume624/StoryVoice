DASHSCOPE_API_KEY=sk-your-key-here
PORT=8787
# 默认是百炼国际站公共地址；中国内地建议替换为业务空间专属地址：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 可选：用于角色分析的通义千问模型
STORY_PLANNER_MODEL=qwen3.8-flash
# 可选：支持自然语言情绪指令的千问语音模型
STORY_TTS_MODEL=qwen3-tts-instruct-flash
# 原生台湾口音 Cindy 使用的全模态模型
STORY_OMNI_MODEL=qwen3.5-omni-plus
